# Ghostty. ./install links ~/.config/ghostty to this directory.
# Machine-specific values such as font-size go in ./local (gitignored).

# Font: Input Mono, installed by hand (https://input.djr.com). Not in this
# repo because its license forbids redistribution.
font-family = "Input Mono"
font-feature = -calt
font-feature = -liga
# U+21E1 is the ⇡ glyph.
font-codepoint-map = U+2190-U+21FF="Input Mono"

# Appearance
theme = kanagawa-dark-dragon
window-theme = ghostty
window-title-font-family = "Input Mono"
window-padding-balance = true
cursor-style = block
background-opacity = 1
window-width = 100
window-height = 35
# Linux only, no effect on macOS
gtk-titlebar-hide-when-maximized = true
gtk-toolbar-style = flat
# Linux only. Kernel 6.5+ counts threads waiting on io_uring as iowait, so
# an idle Ghostty pins vmstat wa and PSI io near 100%. epoll avoids that.
async-backend = epoll

# Convenience
copy-on-select = clipboard
keybind = shift+ctrl+r=clear_screen
keybind = super+key_d=new_split:right
keybind = super+shift+key_d=new_split:down
# macOS only, no effect on Linux
window-save-state = always
# Install Ghostty's terminfo on SSH hosts that lack it. Without it, zsh
# can't redraw the prompt in place and prints duplicate prompts.
shell-integration-features = ssh-terminfo

# Loaded last, so it overrides anything above. Optional.
config-file = ?local
